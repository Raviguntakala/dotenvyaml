# Example .env.yaml configuration
# Copy this to .env.yaml and fill in your values

# Simple key-value pairs
PROJECT_ID: "my-project"
REGION: "us-central1"
DEBUG: false

# Nested keys (auto-flattened to DATABASE_HOST, DATABASE_PORT, etc.)
database:
  host: "localhost"
  port: 5432
  name: "myapp_dev"
  credentials:
    username: "admin"
    password: "change-me"

# Lists (converted to comma-separated: ALLOWED_HOSTS=localhost,example.com)
allowed_hosts:
  - "localhost"
  - "example.com"

# Variable interpolation (use with interpolate=True)
# api:
#   base_url: "https://${REGION}-${PROJECT_ID}.cloudfunctions.net"